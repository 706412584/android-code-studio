<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Explicitly applied to IDE surfaces; do not change upstream terminal widgets. -->
  <style name="acs_ui_button_primary" parent="Widget.Material3.Button">
    <item name="android:minHeight">@dimen/acs_ui_touch_target</item>
    <item name="android:textAppearance">@style/acs_ui_text_button</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="cornerRadius">@dimen/acs_ui_radius_control</item>
  </style>
  <style name="acs_ui_button_secondary" parent="Widget.Material3.Button.TonalButton">
    <item name="android:minHeight">@dimen/acs_ui_touch_target</item>
    <item name="android:textAppearance">@style/acs_ui_text_button</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="cornerRadius">@dimen/acs_ui_radius_control</item>
  </style>
  <style name="acs_ui_button_text" parent="Widget.Material3.Button.TextButton">
    <item name="android:minHeight">@dimen/acs_ui_touch_target</item>
    <item name="android:textAppearance">@style/acs_ui_text_button</item>
    <item name="android:textAllCaps">false</item>
    <item name="cornerRadius">@dimen/acs_ui_radius_control</item>
  </style>
  <style name="acs_ui_input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <item name="boxCornerRadiusTopStart">@dimen/acs_ui_radius_control</item>
    <item name="boxCornerRadiusTopEnd">@dimen/acs_ui_radius_control</item>
    <item name="boxCornerRadiusBottomStart">@dimen/acs_ui_radius_control</item>
    <item name="boxCornerRadiusBottomEnd">@dimen/acs_ui_radius_control</item>
    <item name="boxStrokeWidth">1dp</item>
    <item name="boxStrokeWidthFocused">2dp</item>
  </style>
  <style name="acs_ui_card" parent="Widget.Material3.CardView.Outlined">
    <item name="cardCornerRadius">@dimen/acs_ui_radius_card</item>
    <item name="cardElevation">0dp</item>
    <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    <item name="strokeColor">?attr/colorOutlineVariant</item>
    <item name="strokeWidth">1dp</item>
  </style>
  <style name="acs_ui_input_dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
    <item name="boxCornerRadiusTopStart">@dimen/acs_ui_radius_control</item>
    <item name="boxCornerRadiusTopEnd">@dimen/acs_ui_radius_control</item>
    <item name="boxCornerRadiusBottomStart">@dimen/acs_ui_radius_control</item>
    <item name="boxCornerRadiusBottomEnd">@dimen/acs_ui_radius_control</item>
  </style>
  <style name="acs_ui_project_chip" parent="Widget.Material3.Chip.Filter">
    <item name="chipCornerRadius">@dimen/acs_ui_radius_control</item>
    <item name="chipMinTouchTargetSize">@dimen/acs_ui_touch_target</item>
    <item name="chipStrokeWidth">1dp</item>
    <item name="chipStrokeColor">?attr/colorOutlineVariant</item>
  </style>
  <style name="acs_ui_project_chip_theme" parent="">
    <item name="chipStyle">@style/acs_ui_project_chip</item>
  </style>
  <style name="acs_ui_input_theme" parent="">
    <item name="textInputOutlinedStyle">@style/acs_ui_input</item>
  </style>
  <style name="acs_ui_card_theme" parent="">
    <item name="materialCardViewStyle">@style/acs_ui_card</item>
  </style>
  <style name="acs_ui_dialog_title" parent="MaterialAlertDialog.Material3.Title.Text">
    <item name="android:textAppearance">@style/acs_ui_text_title</item>
  </style>
  <style name="acs_ui_dialog_body" parent="MaterialAlertDialog.Material3.Body.Text">
    <item name="android:textAppearance">@style/acs_ui_text_body</item>
  </style>
  <style name="acs_ui_dialog_button" parent="Widget.Material3.Button.TextButton.Dialog">
    <item name="android:minHeight">@dimen/acs_ui_touch_target</item>
    <item name="android:textAppearance">@style/acs_ui_text_button</item>
    <item name="android:singleLine">false</item>
    <item name="android:maxLines">2</item>
    <item name="android:minLines">1</item>
  </style>
  <style name="acs_ui_dialog_button_neutral" parent="acs_ui_dialog_button">
    <item name="android:layout_marginStart">0dp</item>
    <item name="android:layout_marginLeft">0dp</item>
  </style>
  <style name="acs_ui_icon_button" parent="Widget.Material3.Button.IconButton">
    <item name="android:minWidth">@dimen/acs_ui_touch_target</item>
    <item name="android:minHeight">@dimen/acs_ui_touch_target</item>
    <item name="iconSize">@dimen/acs_ui_icon_size</item>
  </style>
</resources>
