<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:installLocation="internalOnly"
  tools:ignore="Instantiatable">

  <permission
    android:description="@string/permdesc_bind_logger_service"
    android:label="@string/permlab_bind_logger_service"
    android:name="com.tom.rv2ide.permission.BIND_LOG_SERVICE"
    android:protectionLevel="normal"
    tools:ignore="ManifestOrder" />

  <uses-permission android:name="com.tom.rv2ide.permission.BIND_LOG_SERVICE" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
  <uses-permission
    android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
    tools:ignore="ScopedStorage" />
  <uses-permission android:name="android.permission.READ_LOGS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!--
    应用外系统悬浮（AI 助手悬浮窗）。targetSdk=28 在 Android 10 (SDK29) 上
    仍属「特殊权限」：只声明 Manifest 不够，运行时须由设置入口
    （CapabilitiesPage 的 AssistantOverlayPreference）用 Settings.canDrawOverlays()
    检查、经 ACTION_MANAGE_OVERLAY_PERMISSION 引导用户授权后才拉起
    AssistantOverlayService。
  -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <application
    android:allowBackup="false"
    android:allowNativeHeapPointerTagging="false"
    android:enableOnBackInvokedCallback="true"
    android:extractNativeLibs="true"
    android:hardwareAccelerated="true"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:largeHeap="true"
    android:name=".app.IDEApplication"
    android:preserveLegacyExternalStorage="true"
    android:requestLegacyExternalStorage="true"
    android:resizeableActivity="true"
    android:supportsRtl="true"
    android:theme="@style/Theme.AndroidIDE"
    android:networkSecurityConfig="@xml/network_security_config"
    tools:ignore="DiscouragedApi,MediaCapabilities,UnusedAttribute">
    <activity
      android:exported="true"
      android:name=".activities.CrashHandlerActivity"
      android:windowSoftInputMode="stateAlwaysHidden">
      <intent-filter>
        <action android:name="com.tom.rv2ide.REPORT_CRASH" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <activity
      android:exported="true"
      android:name=".activities.SplashActivity"
      android:theme="@style/AppTheme.Splash">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity
      android:exported="false"
      android:name=".activities.OnboardingActivity" />
    <activity
      android:exported="false"
      android:name=".activities.MainActivity"
      android:theme="@style/Theme.AndroidIDE" />
    <activity
      android:configChanges="orientation|screenSize"
      android:launchMode="singleTop"
      android:name=".activities.editor.EditorActivityKt" />

    <!--
      AI 助手真全屏宿主：独立窗口 + 隐藏系统栏（沉浸式）。
      与 FloatingAssistantView.Mode.FULLSCREEN（窗口内最大化）不同，这里是真正的全屏。
    -->
    <activity
      android:exported="false"
      android:name=".activities.editor.AssistantFullscreenActivity"
      android:theme="@style/Theme.AndroidIDE" />

    <activity android:name=".activities.PreferencesActivity" />
    <activity android:name=".activities.AboutActivity" />
    <activity android:name=".activities.ContributorsActivity" />
    <activity android:name=".activities.IDEConfigurations" />
    <activity android:name=".activities.ActivityM3Icons" />

    <activity
      android:name=".activities.TerminalActivity"
      android:windowSoftInputMode="adjustResize" />

    <activity
      android:name=".activities.AssetStudioActivity"
      android:exported="false"
      android:theme="@style/Theme.AndroidIDE" />

    <activity
      android:name=".activities.MaterialIconsWebActivity"
      android:exported="false"
      android:theme="@style/Theme.AndroidIDE" />

    <activity
      android:name=".activities.FolderPickerActivity"
      android:exported="false"
      android:theme="@style/Theme.AndroidIDE" />

    <!-- 助手头像选择。与 FolderPickerActivity 同样是「蹦床 Activity + 静态回调」，
         因为发起方是 Preference（拿不到 Activity / result API）。 -->
    <activity
      android:name=".activities.AvatarPickerActivity"
      android:exported="false"
      android:theme="@style/Theme.AndroidIDE" />

    <activity
      android:name=".activities.FileBrowserActivity"
      android:exported="false"
      android:theme="@style/Theme.AndroidIDE" />

    <activity
      android:name=".activities.NCrashHandlerActivity"
      android:exported="false"
      android:theme="@style/Theme.AndroidIDE" />

    <!--
      附件选择蹦床：透明、无标题、不出现在最近任务里。
      exported=false 是硬性安全要求——被导出则任意应用可借本应用的
      SYSTEM_ALERT_WINDOW 豁免拉起系统选择器（见 AttachmentPickerActivity 类注释）。
      刻意不设 noHistory=true：选择器在前台时蹦床须留在栈里才能收到结果。
    -->
    <activity
      android:name=".activities.AttachmentPickerActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <provider
      android:authorities="com.tom.rv2ide.documents"
      android:exported="true"
      android:grantUriPermissions="true"
      android:name=".provider.IDEDocumentsProvider"
      android:permission="android.permission.MANAGE_DOCUMENTS">
      <intent-filter>
        <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
      </intent-filter>
    </provider>

    <provider
      android:authorities="${applicationId}.providers.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true"
      android:name=".provider.IDEFileProvider">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/ide_file_provider_paths" />
    </provider>

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>

    <receiver
      android:enabled="true"
      android:exported="true"
      android:name=".services.InstallationResultReceiver"
      tools:ignore="ExportedReceiver">
      <intent-filter>
        <action android:name="com.tom.rv2ide.installer.INSTALL_PACKAGE" />
      </intent-filter>
    </receiver>

    <service
      android:exported="false"
      android:name=".services.builder.GradleBuildService" />

    <!--
      应用外系统悬浮助手：前台服务 + TYPE_APPLICATION_OVERLAY 窗口。
      exported=false：只允许本应用启动，避免第三方应用拉起常驻悬浮窗。
    -->
    <service
      android:exported="false"
      android:name=".services.AssistantOverlayService" />

    <service
      android:name="com.termux.app.TermuxService"
      android:enabled="true"
      android:exported="false"
      android:stopWithTask="true" />

    <service
      android:name="io.github.mohammedbaqernull.logger.service.LogReceiverService"
      android:enabled="true"
      android:exported="true">
    </service>

    <!-- <service -->
    <!-- android:exported="true" -->
    <!-- android:name=".services.log.LogReceiverService" -->
    <!-- android:permission="com.tom.rv2ide.permission.BIND_LOG_SERVICE"> -->
    <!-- <intent-filter> -->
    <!-- <action android:name="com.tom.rv2ide.LOG_SERVICE_ACTION" /> -->
    <!-- </intent-filter> -->
    <!-- </service> -->

    <service
      android:enabled="false"
      android:exported="false"
      android:name="androidx.appcompat.app.AppLocalesMetadataHolderService">
      <meta-data
        android:name="autoStoreLocales"
        android:value="true" />
    </service>
    <meta-data
      android:name="android.app.themed_icon"
      android:value="true" />
  </application>
</manifest>