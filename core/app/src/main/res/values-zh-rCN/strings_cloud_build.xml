<!--
  云编译（GitHub Actions）文案（中文）。
  与 values/strings_cloud_build.xml 保持同序，便于对照维护。
-->
<resources>

  <!-- 入口与标题 -->
  <string name="cloud_build_title">云编译</string>
  <string name="cloud_build_action_label">云编译</string>

  <!-- 检测阶段 -->
  <string name="cloud_build_detecting_repo">正在识别项目仓库…</string>
  <string name="cloud_build_no_project">当前没有打开的项目，请先打开一个项目。</string>
  <string name="cloud_build_not_git_repo">这个项目还不是 git 仓库。请先初始化仓库并推送到 GitHub。</string>
  <string name="cloud_build_no_github_remote">没有找到 GitHub 远程仓库。云编译目前只支持 GitHub Actions。</string>
  <string name="cloud_build_no_workflow_local">仓库里没有 workflow 文件。请先添加 .github/workflows/build.yml 并推送。</string>
  <string name="cloud_build_workflow_not_pushed">远程仓库上没有找到 workflow。本地这些文件还没有推送：%1$s。请先把代码推送到 GitHub。</string>

  <!-- 配置 -->
  <string name="cloud_build_repo">仓库：%1$s</string>
  <string name="cloud_build_workflow_hint">Workflow</string>
  <string name="cloud_build_branch_hint">分支</string>
  <string name="cloud_build_token_configured">已配置 GitHub Token</string>
  <string name="cloud_build_token_missing">尚未配置 GitHub Token——触发构建必须要它。</string>
  <string name="cloud_build_configure_token">配置 Token</string>
  <string name="cloud_build_select_workflow">请先选择 workflow。</string>
  <string name="cloud_build_input_branch">请填写分支。</string>
  <string name="cloud_build_start">开始构建</string>
  <string name="cloud_build_retry">重试</string>
  <string name="cloud_build_close">关闭</string>

  <!-- 触发与进度 -->
  <string name="cloud_build_triggering">正在触发 workflow，等待新的运行记录出现…</string>
  <string name="cloud_build_jobs_pending">等待 job 出现…</string>
  <string name="cloud_build_stop_tracking">停止跟踪</string>
  <string name="cloud_build_tracking_stopped">已停止跟踪。构建仍在 GitHub 上继续。</string>
  <string name="cloud_build_poll_failed">进度刷新失败：%1$s</string>

  <!-- 取消构建（远端不可逆操作，与「停止跟踪」区分） -->
  <string name="cloud_build_cancel">取消构建</string>
  <string name="cloud_build_cancel_confirm_title">取消这次构建？</string>
  <string name="cloud_build_cancel_confirm_message">这会在 GitHub 上真正取消本次运行，已经跑过的步骤无法恢复。\n\n如果只是不想继续看进度、想让构建在云端继续跑完，请用「停止跟踪」。</string>
  <string name="cloud_build_cancel_confirm_yes">取消构建</string>
  <string name="cloud_build_cancel_confirm_no">不取消</string>
  <string name="cloud_build_cancelling">正在请求取消…</string>
  <string name="cloud_build_cancel_requested">已请求取消，等待 GitHub 处理…</string>
  <string name="cloud_build_cancel_failed">取消失败：%1$s</string>
  <string name="cloud_build_running_actions_hint">「取消构建」会在 GitHub 上终止运行；「停止跟踪」只停止显示进度，构建继续。</string>
  <string name="cloud_build_cancelled_log_title">运行日志（已被取消）</string>

