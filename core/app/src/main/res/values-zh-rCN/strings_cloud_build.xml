  <string name="cloud_build_history_load_failed">无法加载历史：%1$s</string>

  <!-- 结果 -->
  <string name="cloud_build_failure_title">失败原因（日志片段）</string>
  <string name="cloud_build_fetching_log">正在获取日志…</string>
  <string name="cloud_build_copy_log">复制日志</string>
  <string name="cloud_build_log_copied">日志已复制到剪贴板</string>
  <string name="cloud_build_artifacts_title">构建产物</string>
  <string name="cloud_build_no_artifacts">这次运行没有产物。</string>
  <string name="cloud_build_artifact_list_failed">无法获取产物列表：%1$s</string>
  <string name="cloud_build_artifact_expired">%1$s（已过期）</string>
  <string name="cloud_build_artifact_size">%1$s（%2$s）</string>
  <string name="cloud_build_download">下载</string>
  <string name="cloud_build_downloading">下载中…</string>
  <string name="cloud_build_downloaded">已下载</string>
  <string name="cloud_build_downloaded_to">已保存到：%1$s</string>
  <string name="cloud_build_build_again">再次构建</string>
  <string name="cloud_build_open_run_page">在浏览器打开</string>
  <string name="cloud_build_no_run_page">这次运行没有页面链接。</string>
  <string name="cloud_build_open_page_failed">无法打开运行页面。</string>

  <!-- Token 配置 -->
  <string name="cloud_build_token_title">GitHub Token</string>
  <string name="cloud_build_token_hint">Personal Access Token</string>
  <string name="cloud_build_token_help">请在 GitHub 上创建一个带 repo 与 workflow 权限的 Personal Access Token（classic），然后粘贴到这里。它在本机加密保存，仅用于触发和跟踪构建。</string>
  <string name="cloud_build_token_not_persistent">本机加密存储不可用——Token 只在本次会话内有效。</string>
  <string name="cloud_build_token_save">保存</string>
  <string name="cloud_build_token_saved">Token 已保存</string>
</resources>
