<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮助手的服务商 / 模型选择面板（底部弹出）。

  **单列分组列表**，而不是「服务商一段 + 模型一段」两块独立列表。

  为什么改成单列：两块列表的表达是「先选服务商，再选模型」——两步。但实际使用中
  用户的意图往往已经包含服务商（「切到 Claude 的 opus」），分两步意味着要先切服务商、
  列表跳一下、再找模型。单列把每个服务商及其已配置模型放在一起，一次点击到位。
  这也是参考项目（cc-haha）的做法。

  结构：
    服务商A          ← 组标题，点它切到该服务商的主模型
      主模型  ▸ 已配置
      opus    ▸ 已配置
    服务商B
      主模型
    ...

  只列出**已配置**的服务商与模型：没填密钥的服务商切过去必然请求失败，
  预设里那十几个模型名对用户只是噪音。整组/整项都为空时隐藏。

  高度交给 BottomSheetDialog 约束（它按屏幕可用高度给 AT_MOST），不写
  android:maxHeight —— 该属性只对少数容器生效，NestedScrollView 不认。

  背景用 colorSurface：本仓库 4 套主题都定义了它。
-->
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="?attr/colorSurface">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView
      android:id="@+id/pickerTitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="20dp"
      android:paddingEnd="20dp"
      android:paddingTop="16dp"
      android:paddingBottom="12dp"
      android:text="@string/ai_assistant_model_picker_title"
      android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
      android:textStyle="bold" />

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="?attr/colorOutline" />

    <!--
      单列分组列表本体。内容由 AssistantModelPicker 动态填充：
      每个服务商一个组标题，其下是该服务商已配置的模型行。
    -->
    <LinearLayout
      android:id="@+id/pickerList"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />

    <!-- 一个已配置的服务商都没有时的空态，避免弹出全白面板。 -->
    <TextView
      android:id="@+id/pickerEmpty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="20dp"
      android:paddingEnd="20dp"
      android:paddingTop="20dp"
      android:paddingBottom="20dp"
      android:text="@string/ai_assistant_model_empty"
      android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
      android:textColor="?attr/colorOnSurfaceVariant"
      android:visibility="gone"
      tools:visibility="visible" />

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="8dp"
      android:background="?attr/colorOutline" />

    <!-- 底部入口：配置服务商仍要去设置页。 -->
    <TextView
      android:id="@+id/pickerSettings"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:paddingStart="20dp"
      android:paddingEnd="20dp"
      android:paddingTop="14dp"
      android:paddingBottom="14dp"
      android:text="@string/ai_assistant_settings"
      android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
      android:textColor="?attr/colorPrimary"
      tools:ignore="UnusedAttribute" />

  </LinearLayout>

</androidx.core.widget.NestedScrollView>
