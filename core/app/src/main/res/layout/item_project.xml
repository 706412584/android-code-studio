<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  style="@style/acs_ui_card"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginVertical="@dimen/acs_ui_space_xs">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:minHeight="@dimen/acs_ui_preference_min_height"
    android:paddingHorizontal="@dimen/acs_ui_space_lg"
    android:paddingVertical="@dimen/acs_ui_space_md">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/projectName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/acs_ui_text_section"
        tools:text="Project Name" />

      <TextView
        android:id="@+id/recentBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/acs_ui_space_sm"
        android:paddingHorizontal="@dimen/acs_ui_space_sm"
        android:paddingVertical="@dimen/acs_ui_space_xs"
        android:background="@drawable/acs_ui_badge_background"
        android:text="@string/recent_badge"
        android:textAppearance="@style/acs_ui_text_caption"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:visibility="gone" />
    </LinearLayout>

    <TextView
      android:id="@+id/projectPath"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_xs"
      android:ellipsize="middle"
      android:maxLines="1"
      android:textAppearance="@style/acs_ui_text_caption"
      tools:text="/path/to/project" />
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
