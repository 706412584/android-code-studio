<com.google.android.material.button.MaterialButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_button"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:insetTop="@dimen/acs_ui_space_sm"
    android:insetBottom="@dimen/acs_ui_space_sm"
    android:insetLeft="@dimen/acs_ui_space_sm"
    android:insetRight="@dimen/acs_ui_space_sm"
    android:padding="@dimen/acs_ui_space_xs"
    app:cornerRadius="@dimen/acs_ui_radius_control"
    app:strokeWidth="0dp"
    app:iconSize="@dimen/acs_ui_icon_size"
    android:gravity="center"
    app:iconPadding="0dp"
    app:iconGravity="textTop"
    />