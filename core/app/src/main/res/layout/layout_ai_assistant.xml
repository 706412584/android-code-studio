<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮 AI 助手面板。

  三种形态由代码切换 LayoutParams 实现（不复制三套布局，避免改一处漏一处）：
  - FULLSCREEN：占满可用区域，只留少量边距
  - SIDEBAR：固定宽度贴右侧，露出主屏内容（主页用）
  - DOCKED：贴右侧满高、无外边距无圆角（编辑器用，看起来是编辑器的一半）

  刻意不做成 BottomSheetDialog：bottom sheet 是模态的，展开时会挡住项目列表，
  而这个面板的用途恰恰是"看着主屏问问题"。用平级 overlay 才能两者并存。

  背景色：?attr/colorSurface + cardElevation=0。

  这两个条件是绑定的，不能只改一个。MaterialCardView 在 elevation > 0 时会把
  colorSurfaceTint（本仓库主题未定义，回退到 colorPrimary）以约 12% 透明度叠加到
  colorSurface 上——实测 VSCODE 浅色下得到 #E1EFF9 的淡蓝面板，而编辑器是 #FFFFFF，
  这就是"面板像另一个应用"的直接来源。要保留边界而不要染色，就得把 elevation 归零、
  用 1dp 的 colorOutline 描边。
-->
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/assistantOverlay"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:visibility="gone"
  tools:visibility="visible">

  <com.google.android.material.card.MaterialCardView
    android:id="@+id/assistantCard"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_margin="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical">

      <!--
        标题栏。

        布局：左「菜单」+ 居中标题 + 右侧三键（全屏 / 最小化 / 关闭）。

        左菜单点击从左侧滑出会话列表抽屉。做成抽屉而不是整页互斥切换：
        抽屉保留了「当前对话还在右边」的视觉连续性，用户滑出列表找一条旧会话时
        不会觉得自己离开了对话；整页切换则会让对话内容整个消失，回来时位置也丢了。

        右侧三键用图标而不是文字：文字宽度随语言变化（英文 "Minimize" 比中文
        「最小化」宽一倍），在窄面板里会把标题挤成省略号。图标宽度恒定。
        全屏/侧栏切换从溢出菜单移到这里——它本来就是高频操作，藏在菜单里多余。
      -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/assistantMenu"
          style="@style/Widget.Material3.Button.IconButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:contentDescription="@string/ai_conversation_list_title"
          app:icon="@drawable/ic_menu"
          app:iconTint="?attr/colorOnSurfaceVariant" />

        <!-- 标题居中：两侧按钮数量不等（左 1 右 3），靠 weight 均分会偏。
             用 weight=1 + 居中文字让标题落在剩余空间的中间。

             标题内容运行时替换为**当前项目名**（见 FloatingAssistantView.refreshWorkspaceLabel）：
             这块空间原本只印静态的「AI 助手」，对用户零信息量，而「这个对话绑在哪个项目」
             恰恰是用户看不出来的关键信息。无项目时回退为原来的标题文案。

             ellipsize 用 middle 而非 end：项目名常常长而尾部才有区分度（如
             「.../MyGameActivity」与「.../MyNativeC」），掐尾巴会让两条看起来一样。 -->
        <TextView
          android:id="@+id/assistantTitle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="middle"
          android:gravity="center"
          android:maxLines="1"
          android:text="@string/ai_assistant_title"
          android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
          android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/assistantFullscreen"
          style="@style/Widget.Material3.Button.IconButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:contentDescription="@string/ai_assistant_fullscreen"
          app:icon="@drawable/ic_fullscreen"
          app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/assistantMinimize"
          style="@style/Widget.Material3.Button.IconButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:contentDescription="@string/ai_assistant_minimize"
          app:icon="@drawable/ic_minimize"
          app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/assistantClose"
          style="@style/Widget.Material3.Button.IconButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:contentDescription="@string/ai_assistant_close"
          app:icon="@drawable/ic_close"
          app:iconTint="?attr/colorOnSurfaceVariant" />

      </LinearLayout>

      <!--
        服务商 / 模型选择条已移除——模型与槽位都移进了输入区工具条。

        原先它单独占一行（图标 + 「DeepSeek / deepseek-chat」+ 槽位标签 + 箭头），
        在标题栏与消息列表之间多出约 40dp。移进工具条之后，同一份信息只占一行里
        十几个字符宽，而面板顶部直接就是消息列表。

        未配置密钥的服务商在工具条标签上仍会显示「⚠」前缀（见 refreshModelLabel），
        原先把原因写成整行副标题的做法不再需要——点开选择器里每个服务商都带说明。
      -->

      <!-- 运行结果摘要。没有内容时不占位（初次打开、每次新建会话后都是这种状态）。 -->
      <TextView
        android:id="@+id/assistantStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?android:textColorSecondary"
        android:visibility="gone"
        tools:text="已完成 · 3 轮 · 4 次工具调用"
        tools:visibility="visible" />

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

      <!-- 对话区 -->
      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/assistantMessages"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:clipToPadding="false"
          android:paddingTop="8dp"
          android:paddingBottom="8dp" />

        <TextView
          android:id="@+id/assistantEmpty"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:padding="32dp"
          android:text="@string/ai_assistant_empty_hint"
          android:textAlignment="center"
          android:textColor="?android:textColorSecondary"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

      </FrameLayout>

      <!--
        底部固定的运行状态条。

        **位置**：消息列表下方、输入区上方——即紧贴「它正在描述的那条输出」，
        这也是参考项目（cc-haha）的位置。参考项目的注释明确否决了把它放进输入框：
        输入框区域只保留「停止」按钮，状态行属于对话流而不属于输入控件。

        **为什么删掉了顶部的 LinearProgressIndicator**：那是一条横向进度条，
        但它表达的是「未知时长的等待」——进度条在用户认知里意味着「快到 100% 了」，
        而 agent 工作可能持续几分钟且无法预估，进度条会持续给出错误预期。
        改用文字 + 点阵动画（WorkingStatusView）只表达「在动」，不承诺进度。
        另外它在顶部（`layout_gravity="top"`），与用户等待时视线停留的位置
        （输入框附近）相距最远。

        **为什么带背景而不是裸文字**：它是一条「实时播报」，会被正在滚动的消息列表
        从上方挤过来。裸文字在内容滚动时看起来像消息列表的一部分，加一层
        colorSurfaceContainerLow 底与上方分隔线之后，它是「面板自己的状态栏」这件事
        就没有歧义了。

        默认 gone，由 startWorking/stopWorking 控制。
      -->
      <View
        android:id="@+id/assistantWorkingDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline"
        android:visibility="gone"
        tools:visibility="visible" />

      <com.tom.rv2ide.artificial.agent.WorkingStatusView
        android:id="@+id/assistantWorking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:visibility="gone"
        tools:visibility="visible" />

      <!--
        重试小卡片。与状态条同一位置、同一种「底部固定」语义——重试本身就是
        「当前正在做什么」的一种，只是附带错误码与倒计时，因此用 errorContainer
        底色与状态条区分开，但**不**进消息列表。

        进消息列表的问题：一次运行可能重试 10 次，每次插一条就把对话流刷满，
        而用户只关心「现在重试到第几次、还要多久」。固定卡片原地更新才是对的呈现。
      -->
      <LinearLayout
        android:id="@+id/assistantRetryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorErrorContainer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:contentDescription="@null"
          android:src="@drawable/ic_error"
          app:tint="?attr/colorOnErrorContainer" />

        <TextView
          android:id="@+id/assistantRetryText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="2"
          android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
          android:textColor="?attr/colorOnErrorContainer"
          tools:text="连接中断，8 秒后重试（第 2/10 次）· HTTP 503" />

      </LinearLayout>

      <!--
        任务卡片。放在状态行与输入区之间——「agent 在做什么」与「还有哪些任务」
        是同一类信息，相邻显示便于对照。默认折叠，见 layout_assistant_todos.xml。
      -->
      <include
        android:id="@+id/assistantTodos"
        layout="@layout/layout_assistant_todos" />

      <!--
        输入区：附件标签行 + 「输入框 + 发送按钮」一行 + 工具条一行。

        工具条从左到右：`+`、权限模式、git 分支、弹性留白、服务商、上下文圆环、模型。

        **发送按钮放在输入框最右侧**（输入行内），不再放在工具条里：
        发送是这一区域唯一的高频动作，它和输入框是「写什么 / 提交」的一对，
        贴在一起才符合直觉；放在工具条最右端时，它与输入框之间隔着一整行控件，
        视线要往下再往右各走一次。参考项目（cc-haha）同样是这个位置。

        工具条里因此剩下「设置类」控件（附件、权限、服务商、上下文、模型），
        它们都是低频的，与输入框分属两行之后，输入框那一行只剩下「写」与「发」。

        输入框用 Filled 而不是 Outlined：OutlinedBox 的方角描边在窄容器里显得很"表单"，
        而 Filled 的圆角底与面板整体的圆角语言一致。
      -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <!--
          附件标签行。

          横向可滚而不是自动换行：面板贴边时只有 260dp 宽，两三个文件名就能把高度撑到
          三四行、把输入框顶出可视区；横向滚动把高度固定在一行，长名字靠 chip 自己省略。
          整行在无附件时隐藏，不留空白。
        -->
        <HorizontalScrollView
          android:id="@+id/assistantAttachScroll"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:scrollbars="none"
          android:visibility="gone"
          tools:visibility="visible">

          <com.google.android.material.chip.ChipGroup
            android:id="@+id/assistantAttachList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:chipSpacingHorizontal="6dp" />

        </HorizontalScrollView>

        <!--
          输入行：输入框 + 发送按钮。

          发送按钮与输入框**同高对齐**（gravity=bottom）：输入框会长高到 5 行，
          按钮固定 40dp，靠底部对齐时它的位置随输入框增长而自然下移，
          视线始终落在「刚写完的那一行旁边」。
        -->
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="bottom">

          <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/AppTheme.TextInputLayout.AssistantInput"
            android:hint="@string/ai_assistant_input_hint">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/assistantInput"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="textMultiLine|textCapSentences"
              android:maxLines="5"
              android:imeOptions="actionSend" />

          </com.google.android.material.textfield.TextInputLayout>

          <!--
            发送 / 停止。运行时换成停止图标与 error 配色——这是「agent 正在跑」
            最直接的状态信号，与底部的动作条互为补充。
          -->
          <com.google.android.material.button.MaterialButton
            android:id="@+id/assistantSend"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="4dp"
            android:contentDescription="@string/ai_assistant_send"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_arrow_upward"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        </LinearLayout>

        <!--
          单行工具条（设置类控件）。

          从左到右：`+`、权限模式、git 分支、弹性留白、服务商、上下文圆环、模型。

          没有分隔线，只靠间距分组（左组 = 输入相关，右组 = 模型状态）——
          分隔线在 300dp 宽的一行里会把它切成三段，看起来像三个独立控件条。

          中间用 Space(weight=1) 撑开：左侧控件数量随面板宽度变化（窄时隐藏 git），
          靠 weight 让右侧组始终贴右边缘，比给右侧组加 gravity=end 更稳——
          后者在左组换行或增删时会出现「右侧组被推着走」的抖动。
        -->
        <LinearLayout
          android:id="@+id/assistantToolbar"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:paddingTop="2dp">

          <!-- `+`：附件与推理强度都收进它的菜单。 -->
          <com.google.android.material.button.MaterialButton
            android:id="@+id/assistantToolbarAdd"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/ai_assistant_toolbar_menu_title"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_add"
            app:iconSize="20dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />

          <!--
            权限模式。显示当前档位的**短名**（自动放行 / 需确认 / 只读），
            点开是三档单选。

            放在工具条而不是只在设置页：权限模式是「我这次想让 AI 做到什么程度」，
            会随任务变化（看一眼代码时用只读，改代码时用需确认），
            埋在设置里等于每次都要离开对话去改。
          -->
          <TextView
            android:id="@+id/assistantPermissionChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_assistant_slot_chip"
            android:clickable="true"
            android:focusable="true"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="?attr/colorPrimary"
            tools:text="需确认" />

          <!--
            git 分支。仓库根没有 .git 时整块隐藏——在非 git 项目里显示一个空的分支
            标签会让人以为仓库状态读取失败。

            窄面板下也会隐藏，见 FloatingAssistantView.applyToolbarDensity()：
            这一行在 260dp 面板里放不下 5 个控件。
          -->
          <LinearLayout
            android:id="@+id/assistantGitChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_assistant_chip_neutral"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
              android:layout_width="12dp"
              android:layout_height="12dp"
              android:contentDescription="@null"
              android:src="@drawable/ic_branches"
              app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
              android:id="@+id/assistantGitBranch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="4dp"
              android:ellipsize="end"
              android:maxEms="10"
              android:maxLines="1"
              android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
              android:textColor="?attr/colorOnSurfaceVariant"
              tools:text="main" />

          </LinearLayout>

          <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

          <!--
            服务商。显示当前服务商名，点开是「服务商 → 其已配置模型」的分组列表。

            与模型名分开显示而不是合成一段「服务商 / 模型」：合成后两段文字在窄面板里
            都会被压成省略号，用户既看不出服务商也看不出模型。分开之后各自独立省略，
            至少还能读出「哪个服务商」。

            极窄时整块隐藏（见 applyToolbarDensity），模型名会顶上。
          -->
          <TextView
            android:id="@+id/assistantToolbarProvider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="92dp"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="DeepSeek" />

          <!--
            上下文占用圆环。点它弹详细信息并提供「压缩上下文」入口。

            contentDescription **不写在这里**：XML 的 contentDescription 不做占位符
            替换，写一个带 %1$s 的资源会让无障碍服务逐字读出「上下文占用 %1$s」
            （实测 UI dump 里就是这个字符串）。描述由 ContextRingView.bind 在
            拿到真实数字后渲染。未配置上下文窗口时该视图会被设为 gone。
          -->
          <com.tom.rv2ide.artificial.agent.ContextRingView
            android:id="@+id/assistantContextRing"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

          <!-- 模型名。点它同样打开选择器（与服务商标签是同一个入口）。 -->
          <TextView
            android:id="@+id/assistantToolbarModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="124dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="deepseek-chat" />

        </LinearLayout>

      </LinearLayout>

    </LinearLayout>

  </com.google.android.material.card.MaterialCardView>

  <!--
    会话列表抽屉。

    放在 assistantCard **之后**（同级、兄弟节点）：ConstraintLayout 里后声明的子视图
    绘制在上层，因此抽屉能盖住面板。放进面板内部做不到这一点——抽屉需要从面板
    左边缘滑出并盖住整个面板宽度，而面板内部的空间会被标题栏/消息列表挤占。

    整层是一个 FrameLayout：遮罩与抽屉叠在一起，点遮罩即关闭。
  -->
  <FrameLayout
    android:id="@+id/assistantDrawerOverlay"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:visibility="gone"
    tools:visibility="visible"
    app:layout_constraintBottom_toBottomOf="@id/assistantCard"
    app:layout_constraintEnd_toEndOf="@id/assistantCard"
    app:layout_constraintStart_toStartOf="@id/assistantCard"
    app:layout_constraintTop_toTopOf="@id/assistantCard">

    <!--
      遮罩。半透明黑而不是纯透明：抽屉浮在对话之上，没有遮罩时用户分不清
      「列表是浮层」还是「对话被换掉了」。点击关闭。
    -->
    <View
      android:id="@+id/assistantDrawerScrim"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#80000000"
      android:clickable="true"
      android:focusable="true" />

    <!--
      抽屉本体。宽度 240dp 且不超过容器的 78%：窄面板（贴边形态可能只有 300dp）上
      固定 240dp 会盖掉几乎全部对话，比例上限保证右侧始终露出一条对话区。
    -->
    <LinearLayout
      android:id="@+id/assistantDrawer"
      android:layout_width="240dp"
      android:layout_height="match_parent"
      android:layout_gravity="start"
      android:background="?attr/colorSurface"
      android:orientation="vertical"
      android:elevation="8dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:text="@string/ai_conversation_list_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
        android:textStyle="bold" />

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/assistantConversations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

      <TextView
        android:id="@+id/assistantConversationsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/ai_conversation_empty"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?android:textColorSecondary"
        android:visibility="gone"
        tools:visibility="visible" />

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

      <!--
        抽屉底部的两个动作。

        新建会话与设置放在这里而不是标题栏：标题栏右侧已有三个按钮，再加会挤掉标题；
        而这两个动作的使用场景恰好都是「打开列表时顺手做」（找会话时想开新的、
        或想去调配置），放抽屉里比放标题栏更贴合意图。

        溢出菜单因此取消——它原先只承载「全屏/设置/复制/关闭」四项，
        全屏移到标题栏、设置移到此处、关闭移到标题栏，只剩「复制」无处可去，
        也一并移到这里。
      -->
      <com.google.android.material.button.MaterialButton
        android:id="@+id/assistantNewConversation"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:text="@string/ai_assistant_new_conversation"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorOnSurfaceVariant" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/assistantCopyConversation"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:text="@string/ai_assistant_export"
        app:icon="@drawable/ic_content_copy"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorOnSurfaceVariant" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/assistantSettings"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:text="@string/ai_assistant_settings"
        app:icon="@drawable/ic_settings"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

  </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
