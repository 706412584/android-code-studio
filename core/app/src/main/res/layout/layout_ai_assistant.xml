<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮 AI 助手面板。

  三种形态由代码切换 LayoutParams 实现（不复制三套布局，避免改一处漏一处）：
  - FULLSCREEN：占满可用区域，只留少量边距
  - SIDEBAR：固定宽度贴右侧，露出主屏内容（主页用）
  - DOCKED：贴右侧满高、无外边距无圆角（编辑器用，看起来是编辑器的一半）

  刻意不做成 BottomSheetDialog：bottom sheet 是模态的，展开时会挡住项目列表，
  而这个面板的用途恰恰是"看着主屏问问题"。用平级 overlay 才能两者并存。

  背景色：?attr/colorSurface + cardElevation=0。

  这两个条件是绑定的，不能只改一个。MaterialCardView 在 elevation > 0 时会把
  colorSurfaceTint（本仓库主题未定义，回退到 colorPrimary）以约 12% 透明度叠加到
  colorSurface 上——实测 VSCODE 浅色下得到 #E1EFF9 的淡蓝面板，而编辑器是 #FFFFFF，
  这就是"面板像另一个应用"的直接来源。要保留边界而不要染色，就得把 elevation 归零、
  用 1dp 的 colorOutline 描边。
-->
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/assistantOverlay"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:visibility="gone"
  tools:visibility="visible">

  <com.google.android.material.card.MaterialCardView
    android:id="@+id/assistantCard"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_margin="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical">

      <!--
        顶栏（2026-10-09 接线）：整个标题栏由移植的 ChatHeader 承载——
        左菜单开抽屉、右侧新建会话 + Git / 终端 + 全屏（全屏时变最小化图标）。
        原 XML 的 assistantMenu/assistantTitle/assistantFullscreen/assistantMinimize/
        assistantClose 五控件退役：字体/交互由 Compose 组件自管，宿主只注入回调。

        Aharou 的顶栏没有标题位：会话名在抽屉里可改名，顶栏把空间留给按钮。
        关闭键不再恢复——页面形态的收起语义由宿主返回键承载。
        模型切换也不在顶栏，在输入栏芯片（与 Aharou 一致）。
      -->
      <androidx.compose.ui.platform.ComposeView
        android:id="@+id/assistantHeaderCompose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

      <!--
        服务商 / 模型选择条已移除——模型与槽位都移进了输入区工具条。

        原先它单独占一行（图标 + 「DeepSeek / deepseek-chat」+ 槽位标签 + 箭头），
        在标题栏与消息列表之间多出约 40dp。移进工具条之后，同一份信息只占一行里
        十几个字符宽，而面板顶部直接就是消息列表。

        未配置密钥的服务商在工具条标签上仍会显示「⚠」前缀（见 refreshModelLabel），
        原先把原因写成整行副标题的做法不再需要——点开选择器里每个服务商都带说明。
      -->

      <!-- 运行结果摘要。没有内容时不占位（初次打开、每次新建会话后都是这种状态）。 -->
      <TextView
        android:id="@+id/assistantStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?android:textColorSecondary"
        android:visibility="gone"
        tools:text="已完成 · 3 轮 · 4 次工具调用"
        tools:visibility="visible" />

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

      <!-- 对话区 -->
      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/assistantMessages"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:clipToPadding="false"
          android:paddingTop="8dp"
          android:paddingBottom="8dp" />

        <TextView
          android:id="@+id/assistantEmpty"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:padding="32dp"
          android:text="@string/ai_assistant_empty_hint"
          android:textAlignment="center"
          android:textColor="?android:textColorSecondary"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <!-- 滚动到底部 FAB：用户向上滚动时浮现，点击立刻快速平滑回到底部 -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
          android:id="@+id/assistantScrollBottomFab"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom|end"
          android:layout_marginEnd="16dp"
          android:layout_marginBottom="16dp"
          android:contentDescription="回到底部"
          android:visibility="gone"
          app:fabSize="mini"
          app:srcCompat="@drawable/ic_chevron_down" />

      </FrameLayout>

      <!--
        底部固定的运行状态条。

        **位置**：消息列表下方、输入区上方——即紧贴「它正在描述的那条输出」，
        这也是参考项目（cc-haha）的位置。参考项目的注释明确否决了把它放进输入框：
        输入框区域只保留「停止」按钮，状态行属于对话流而不属于输入控件。

        **为什么删掉了顶部的 LinearProgressIndicator**：那是一条横向进度条，
        但它表达的是「未知时长的等待」——进度条在用户认知里意味着「快到 100% 了」，
        而 agent 工作可能持续几分钟且无法预估，进度条会持续给出错误预期。
        改用文字 + 点阵动画（WorkingStatusView）只表达「在动」，不承诺进度。
        另外它在顶部（`layout_gravity="top"`），与用户等待时视线停留的位置
        （输入框附近）相距最远。

        **为什么带背景而不是裸文字**：它是一条「实时播报」，会被正在滚动的消息列表
        从上方挤过来。裸文字在内容滚动时看起来像消息列表的一部分，加一层
        colorSurfaceContainerLow 底与上方分隔线之后，它是「面板自己的状态栏」这件事
        就没有歧义了。

        默认 gone，由 startWorking/stopWorking 控制。
      -->
      <View
        android:id="@+id/assistantWorkingDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline"
        android:visibility="gone"
        tools:visibility="visible" />

      <com.tom.rv2ide.artificial.agent.WorkingStatusView
        android:id="@+id/assistantWorking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:visibility="gone"
        tools:visibility="visible" />

      <!--
        重试小卡片。与状态条同一位置、同一种「底部固定」语义——重试本身就是
        「当前正在做什么」的一种，只是附带错误码与倒计时，因此用 errorContainer
        底色与状态条区分开，但**不**进消息列表。

        进消息列表的问题：一次运行可能重试 10 次，每次插一条就把对话流刷满，
        而用户只关心「现在重试到第几次、还要多久」。固定卡片原地更新才是对的呈现。
      -->
      <LinearLayout
        android:id="@+id/assistantRetryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorErrorContainer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:contentDescription="@null"
          android:src="@drawable/ic_error"
          app:tint="?attr/colorOnErrorContainer" />

        <TextView
          android:id="@+id/assistantRetryText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="2"
          android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
          android:textColor="?attr/colorOnErrorContainer"
          tools:text="连接中断，8 秒后重试（第 2/10 次）· HTTP 503" />

      </LinearLayout>

      <!--
        任务卡片。放在状态行与输入区之间——「agent 在做什么」与「还有哪些任务」
        是同一类信息，相邻显示便于对照。默认折叠，见 layout_assistant_todos.xml。
      -->
      <include
        android:id="@+id/assistantTodos"
        layout="@layout/layout_assistant_todos" />

      <!--
        浮动工具状态条（2026-10-09 接线）：Aharou 的 FloatingToolStatusBar——
        最近工具的迷你终端缩略图 + 运行状态 + ‹ n/m › 翻页 + 停止键。
        数据源：adapter 的 TOOL 消息（经 composePanel.state）+ inputBar.liveToolOutput
        （PROGRESS 实时累积）。放输入栏正上方——Aharou 也叠在输入区附近，
        且与「此刻在做什么」的状态条（assistantWorking）语义互补：那条说一句话，
        这条带完整缩略输出。
      -->
      <androidx.compose.ui.platform.ComposeView
        android:id="@+id/assistantToolStatusBarCompose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

      <!--
        Compose 输入栏（2026-10-09 接线）：整个输入区（附件预览行 + 输入框 + 模式胶囊 +
        模型/推理强度 + 发送停止环 + 待办/排队/斜杠菜单浮层）由移植的 ChatInputBar 承载。
        原 XML 的附件 chips、TextInputEditText、停止/发送键、单行工具条退役——
        控件回调仍落回宿主既有方法（sendFromInput/onStopClicked/…），运行态经
        inputBarState 桥进 Compose。

        刻意保留一个 LinearLayout 包一层：原约束体系把它当普通子项处理，不动外层。
      -->
      <LinearLayout
        android:id="@+id/assistantInputBarHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.compose.ui.platform.ComposeView
          android:id="@+id/assistantInputBarCompose"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />

      </LinearLayout>

    </LinearLayout>

  </com.google.android.material.card.MaterialCardView>

  <!--
    会话列表抽屉。

    放在 assistantCard **之后**（同级、兄弟节点）：ConstraintLayout 里后声明的子视图
    绘制在上层，因此抽屉能盖住面板。放进面板内部做不到这一点——抽屉需要从面板
    左边缘滑出并盖住整个面板宽度，而面板内部的空间会被标题栏/消息列表挤占。

    整层是一个 FrameLayout：遮罩与抽屉叠在一起，点遮罩即关闭。
  -->
  <FrameLayout
    android:id="@+id/assistantDrawerOverlay"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:visibility="gone"
    tools:visibility="visible"
    app:layout_constraintBottom_toBottomOf="@id/assistantCard"
    app:layout_constraintEnd_toEndOf="@id/assistantCard"
    app:layout_constraintStart_toStartOf="@id/assistantCard"
    app:layout_constraintTop_toTopOf="@id/assistantCard">

    <!--
      遮罩。半透明黑而不是纯透明：抽屉浮在对话之上，没有遮罩时用户分不清
      「列表是浮层」还是「对话被换掉了」。点击关闭。
    -->
    <View
      android:id="@+id/assistantDrawerScrim"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#80000000"
      android:clickable="true"
      android:focusable="true" />

    <!--
      抽屉本体。宽度 280dp 且不超过容器的 78%：窄面板（贴边形态可能只有 300dp）上
      固定宽会盖掉几乎全部对话，比例上限保证右侧始终露出一条对话区。

      2026-10-09 接线：内部内容由 XML（RecyclerView + 底部三按钮）换成 Compose 的
      ChatDrawerContent（会话/文件双 Tab + 搜索 + 状态点）。原 XML 控件退役：
      会话列表/空态/三个动作全部由 Compose 侧承载（动作回调仍落回宿主既有方法）。
    -->
    <FrameLayout
      android:id="@+id/assistantDrawer"
      android:layout_width="280dp"
      android:layout_height="match_parent"
      android:layout_gravity="start"
      android:background="?attr/colorSurface"
      android:elevation="8dp">

      <androidx.compose.ui.platform.ComposeView
        android:id="@+id/assistantDrawerCompose"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    </FrameLayout>

  </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
