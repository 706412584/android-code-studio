<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮 AI 助手面板。

  三种形态由代码切换 LayoutParams 实现（不复制三套布局，避免改一处漏一处）：
  - FULLSCREEN：占满可用区域，只留少量边距
  - SIDEBAR：固定宽度贴右侧，露出主屏内容（主页用）
  - DOCKED：贴右侧满高、无外边距无圆角（编辑器用，看起来是编辑器的一半）

  刻意不做成 BottomSheetDialog：bottom sheet 是模态的，展开时会挡住项目列表，
  而这个面板的用途恰恰是"看着主屏问问题"。用平级 overlay 才能两者并存。

  背景色：?attr/colorSurface + cardElevation=0。

  这两个条件是绑定的，不能只改一个。MaterialCardView 在 elevation > 0 时会把
  colorSurfaceTint（本仓库主题未定义，回退到 colorPrimary）以约 12% 透明度叠加到
  colorSurface 上——实测 VSCODE 浅色下得到 #E1EFF9 的淡蓝面板，而编辑器是 #FFFFFF，
  这就是"面板像另一个应用"的直接来源。要保留边界而不要染色，就得把 elevation 归零、
  用 1dp 的 colorOutline 描边。
-->
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/assistantOverlay"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:visibility="gone"
  tools:visibility="visible">

  <com.google.android.material.card.MaterialCardView
    android:id="@+id/assistantCard"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_margin="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical">

      <!--
        标题栏。

        布局：左「菜单」+ 居中标题 + 右侧三键（全屏 / 最小化 / 关闭）。

        左菜单点击从左侧滑出会话列表抽屉。做成抽屉而不是整页互斥切换：
        抽屉保留了「当前对话还在右边」的视觉连续性，用户滑出列表找一条旧会话时
        不会觉得自己离开了对话；整页切换则会让对话内容整个消失，回来时位置也丢了。

        右侧三键用图标而不是文字：文字宽度随语言变化（英文 "Minimize" 比中文
        「最小化」宽一倍），在窄面板里会把标题挤成省略号。图标宽度恒定。
        全屏/侧栏切换从溢出菜单移到这里——它本来就是高频操作，藏在菜单里多余。
      -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/assistantMenu"
          style="@style/Widget.Material3.Button.IconButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:contentDescription="@string/ai_conversation_list_title"
          app:icon="@drawable/ic_menu"
          app:iconTint="?attr/colorOnSurfaceVariant" />

        <!-- 标题居中：两侧按钮数量不等（左 1 右 3），靠 weight 均分会偏。
             用 weight=1 + 居中文字让标题落在剩余空间的中间。 -->
        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:gravity="center"
          android:maxLines="1"
          android:text="@string/ai_assistant_title"
          android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
          android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/assistantFullscreen"
          style="@style/Widget.Material3.Button.IconButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:contentDescription="@string/ai_assistant_fullscreen"
          app:icon="@drawable/ic_fullscreen"
          app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/assistantMinimize"
          style="@style/Widget.Material3.Button.IconButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:contentDescription="@string/ai_assistant_minimize"
          app:icon="@drawable/ic_minimize"
          app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/assistantClose"
          style="@style/Widget.Material3.Button.IconButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:contentDescription="@string/ai_assistant_close"
          app:icon="@drawable/ic_close"
          app:iconTint="?attr/colorOnSurfaceVariant" />

      </LinearLayout>

      <!--
        服务商 / 模型选择条。

        整行是一个点击目标，而不是两个下拉框：侧栏模式下面板宽度只有屏幕的 88%，
        再并排放两个控件会把服务商名挤成省略号（「Anthropic Cl…」），
        用户分不清选的是哪个。整行可点则标签有完整宽度，选择放进面板里做。

        未配置密钥的服务商会带「⚠ …（未配置密钥）」前缀：否则用户切过去、
        发一条消息、收到「未配置有效的 API 密钥」，要绕一圈才知道问题在哪。
      -->
      <LinearLayout
        android:id="@+id/assistantModelBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <ImageView
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:contentDescription="@null"
          android:src="@drawable/ic_agent_switch"
          app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
          android:id="@+id/assistantModelLabel"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="8dp"
          android:ellipsize="middle"
          android:singleLine="true"
          android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
          android:textColor="?attr/colorOnSurfaceVariant"
          tools:text="DeepSeek / deepseek-chat" />

        <ImageView
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:contentDescription="@null"
          android:src="@drawable/ic_chevron_down"
          app:tint="?attr/colorOnSurfaceVariant" />

      </LinearLayout>

      <!-- 运行结果摘要。没有内容时不占位（初次打开、每次新建会话后都是这种状态）。 -->
      <TextView
        android:id="@+id/assistantStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?android:textColorSecondary"
        android:visibility="gone"
        tools:text="已完成 · 3 轮 · 4 次工具调用"
        tools:visibility="visible" />

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

      <!-- 对话区 -->
      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/assistantMessages"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:clipToPadding="false"
          android:paddingTop="8dp"
          android:paddingBottom="8dp" />

        <TextView
          android:id="@+id/assistantEmpty"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:padding="32dp"
          android:text="@string/ai_assistant_empty_hint"
          android:textAlignment="center"
          android:textColor="?android:textColorSecondary"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
          android:id="@+id/assistantProgress"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="top"
          android:visibility="gone"
          android:indeterminate="true" />

      </FrameLayout>

      <!--
        「思考中…」/「处理中…」状态条。

        放在消息列表与输入框之间：这是用户等待时视线停留的位置（刚按下发送、
        目光还在输入框附近），比顶部标题栏更容易被注意到。
        默认 gone，由 startWorking/stopWorking 控制。
      -->
      <com.tom.rv2ide.artificial.agent.WorkingStatusView
        android:id="@+id/assistantWorking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        tools:visibility="visible" />

      <!--
        输入区。

        用「输入框在上、发送按钮在下」的两行结构，而不是并排一行：
        侧栏模式下面板宽度只有屏幕的 88%，并排时输入框会被发送按钮挤掉近三分之一宽，
        中文长句（「把 build.gradle 里的 compileSdk 改成 34」）一屏看不全。
        发送按钮独立成行后输入框拿满宽度。

        输入框用 Filled 而不是 Outlined：OutlinedBox 的方角描边在窄容器里显得很"表单"，
        而 Filled 的圆角底与面板整体的圆角语言一致。
      -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <com.google.android.material.textfield.TextInputLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          style="@style/AppTheme.TextInputLayout.AssistantInput"
          android:hint="@string/ai_assistant_input_hint">

          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/assistantInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:imeOptions="actionSend" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
          android:id="@+id/assistantSend"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:minHeight="44dp"
          android:text="@string/ai_assistant_send" />

      </LinearLayout>

    </LinearLayout>

  </com.google.android.material.card.MaterialCardView>

  <!--
    会话列表抽屉。

    放在 assistantCard **之后**（同级、兄弟节点）：ConstraintLayout 里后声明的子视图
    绘制在上层，因此抽屉能盖住面板。放进面板内部做不到这一点——抽屉需要从面板
    左边缘滑出并盖住整个面板宽度，而面板内部的空间会被标题栏/消息列表挤占。

    整层是一个 FrameLayout：遮罩与抽屉叠在一起，点遮罩即关闭。
  -->
  <FrameLayout
    android:id="@+id/assistantDrawerOverlay"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:visibility="gone"
    tools:visibility="visible"
    app:layout_constraintBottom_toBottomOf="@id/assistantCard"
    app:layout_constraintEnd_toEndOf="@id/assistantCard"
    app:layout_constraintStart_toStartOf="@id/assistantCard"
    app:layout_constraintTop_toTopOf="@id/assistantCard">

    <!--
      遮罩。半透明黑而不是纯透明：抽屉浮在对话之上，没有遮罩时用户分不清
      「列表是浮层」还是「对话被换掉了」。点击关闭。
    -->
    <View
      android:id="@+id/assistantDrawerScrim"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#80000000"
      android:clickable="true"
      android:focusable="true" />

    <!--
      抽屉本体。宽度 240dp 且不超过容器的 78%：窄面板（贴边形态可能只有 300dp）上
      固定 240dp 会盖掉几乎全部对话，比例上限保证右侧始终露出一条对话区。
    -->
    <LinearLayout
      android:id="@+id/assistantDrawer"
      android:layout_width="240dp"
      android:layout_height="match_parent"
      android:layout_gravity="start"
      android:background="?attr/colorSurface"
      android:orientation="vertical"
      android:elevation="8dp">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:text="@string/ai_conversation_list_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
        android:textStyle="bold" />

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/assistantConversations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

      <TextView
        android:id="@+id/assistantConversationsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/ai_conversation_empty"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?android:textColorSecondary"
        android:visibility="gone"
        tools:visibility="visible" />

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

      <!--
        抽屉底部的两个动作。

        新建会话与设置放在这里而不是标题栏：标题栏右侧已有三个按钮，再加会挤掉标题；
        而这两个动作的使用场景恰好都是「打开列表时顺手做」（找会话时想开新的、
        或想去调配置），放抽屉里比放标题栏更贴合意图。

        溢出菜单因此取消——它原先只承载「全屏/设置/复制/关闭」四项，
        全屏移到标题栏、设置移到此处、关闭移到标题栏，只剩「复制」无处可去，
        也一并移到这里。
      -->
      <com.google.android.material.button.MaterialButton
        android:id="@+id/assistantNewConversation"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:text="@string/ai_assistant_new_conversation"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorOnSurfaceVariant" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/assistantCopyConversation"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:text="@string/ai_assistant_export"
        app:icon="@drawable/ic_content_copy"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorOnSurfaceVariant" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/assistantSettings"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:text="@string/ai_assistant_settings"
        app:icon="@drawable/ic_settings"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

  </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
