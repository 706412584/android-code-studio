<RelativeLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:translationY="-4dp"
  >

  <com.google.android.material.card.MaterialCardView
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    app:strokeWidth="0dp"
    app:cardElevation="0dp"
    android:scaleX="0.9"
    android:scaleY="0.9"
    app:cardBackgroundColor="?attr/colorSurface">

    <eightbitlab.com.blurview.BlurView
      android:id="@+id/blurView"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">
      
      <ViewFlipper
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/editor_sheet_collapsed_height"
        android:background="@android:color/transparent">

        <include
          layout="@layout/layout_editor_build_status"
          android:id="@+id/build_status"/>

        <com.tom.rv2ide.ui.SymbolInputView
          android:id="@+id/symbol_input"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"/>

        <include
          layout="@layout/layout_editor_bottom_action"
          android:id="@+id/bottom_action"/>

      </ViewFlipper>
    </eightbitlab.com.blurview.BlurView>

  </com.google.android.material.card.MaterialCardView>

  <com.google.android.material.tabs.TabLayout
    android:id="@+id/tabs"
    style="@style/AppTheme.TabLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@id/cardView" />

  <!--
    底部占位：pager / clear_fab / share_output_fab 都以 layout_above="@id/space_bottom"
    定位。这里 wrap_content（Space 无内容 → 运行时高度 0）是**有意**的，不要改成具体高度：
    底部空间由 EditorBottomSheet.setOffsetAnchor 在运行时通过
    binding.root.updatePadding(bottom = anchorOffset + insetBottom) 预留，
    layout_above 是相对内边距内的底边定位的。若在此再给固定高度会双重预留，
    把输出面板压窄。tools:layout_height 仅供预览，不参与运行时布局。
  -->
  <androidx.legacy.widget.Space
    android:id="@+id/space_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    tools:layout_height="56dp" />

  <androidx.viewpager2.widget.ViewPager2
    android:id="@+id/pager"
    android:background="?android:attr/colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_above="@id/space_bottom"
    android:layout_below="@id/tabs"
    android:clickable="true"
    android:focusable="false" />

  <com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/clear_fab"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_above="@id/space_bottom"
    android:layout_alignParentEnd="true"
    android:layout_margin="16dp"
    android:src="@drawable/ic_sweep_delete" />

  <com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/share_output_fab"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_above="@id/clear_fab"
    android:layout_alignParentEnd="true"
    android:layout_marginStart="16dp"
    android:layout_marginTop="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="16dp"
    android:src="@drawable/ic_share" />

</RelativeLayout>