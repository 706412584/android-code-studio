<?xml version="1.0" encoding="utf-8"?><!--
  ~  This file is part of AndroidCodeStudio.
  ~
  ~  JDK 管理器：一处管理 JDK 的安装、卸载与切换。
  ~  为什么独立成页而不是设置里的单选弹窗：单选弹窗只能「选一个」，而这里
  ~  还要能装/卸（apt），弹窗没地方放这些动作；且 JDK 数量会随安装增长。
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/root_layout"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?android:attr/colorBackground"
  android:fitsSystemWindows="true"
  android:orientation="vertical">

  <com.google.android.material.appbar.AppBarLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    app:elevation="0dp">

    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="?attr/actionBarSize"
      android:paddingHorizontal="@dimen/acs_ui_space_sm"
      app:navigationContentDescription="@string/back"
      app:navigationIcon="@drawable/ic_arrow_back"
      app:navigationIconTint="?attr/colorOnSurface"
      app:subtitle="@string/idepref_jdk_manager_subtitle"
      app:subtitleTextAppearance="@style/acs_ui_text_caption"
      app:title="@string/idepref_jdk_manager_title"
      app:titleTextAppearance="@style/acs_ui_text_section" />
  </com.google.android.material.appbar.AppBarLayout>

  <androidx.core.widget.NestedScrollView
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/acs_ui_space_xl"
    android:scrollbars="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <!-- 说明来源：JDK 不是 sdkmanager 的包，用户常误以为在同一处管理 -->
      <com.google.android.material.textview.MaterialTextView
        android:id="@+id/jdk_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/acs_ui_page_padding"
        android:layout_marginTop="@dimen/acs_ui_space_sm"
        android:paddingHorizontal="@dimen/acs_ui_space_sm"
        android:paddingVertical="@dimen/acs_ui_space_sm"
        android:background="?attr/colorSurfaceContainerLow"
        android:text="@string/jdk_apt_hint"
        android:textAppearance="@style/acs_ui_text_body"
        android:textColor="?attr/colorOnSurfaceVariant" />

      <!-- JDK 卡片由代码动态填充 -->
      <LinearLayout
        android:id="@+id/jdk_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/acs_ui_space_xs"
        android:orientation="vertical" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <!-- 操作输出面板：结构与 SDK 管理器一致（可折叠，操作时展开、成功即收起） -->
  <com.google.android.material.card.MaterialCardView
    android:id="@+id/output_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/acs_ui_space_sm"
    android:layout_marginTop="@dimen/acs_ui_space_xs"
    android:layout_marginBottom="@dimen/acs_ui_space_sm"
    android:visibility="gone"
    style="@style/acs_ui_card"
    tools:visibility="visible">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="@dimen/acs_ui_space_lg">

      <LinearLayout
        android:id="@+id/output_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/acs_ui_touch_target"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/output_toggle_icon"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_marginEnd="@dimen/acs_ui_space_sm"
          android:contentDescription="@string/sdk_output_toggle"
          android:tint="?attr/colorOnSurfaceVariant"
          android:src="@drawable/ic_chevron_down" />

        <com.google.android.material.textview.MaterialTextView
          android:id="@+id/output_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:textAppearance="@style/acs_ui_text_section"
          tools:text="正在安装 JDK 21…" />
      </LinearLayout>

      <ScrollView
        android:id="@+id/output_scroll"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="@dimen/acs_ui_space_sm"
        android:background="?attr/colorSurface"
        android:padding="@dimen/acs_ui_space_sm">

        <com.google.android.material.textview.MaterialTextView
          android:id="@+id/output_text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="monospace"
          android:textColor="?attr/colorOnSurfaceVariant"
          android:textSize="@dimen/acs_ui_caption_size" />
      </ScrollView>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</LinearLayout>
