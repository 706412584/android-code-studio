<?xml version="1.0" encoding="utf-8"?><!--
  ~  This file is part of AndroidCodeStudio.
  ~
  ~  JDK 管理器：一处管理 JDK 的安装、卸载与切换。
  ~  为什么独立成页而不是设置里的单选弹窗：单选弹窗只能「选一个」，而这里
  ~  还要能装/卸（apt），弹窗没地方放这些动作；且 JDK 数量会随安装增长。
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/root_layout"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true"
  android:orientation="vertical">

  <com.google.android.material.appbar.AppBarLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      app:subtitle="@string/idepref_jdk_manager_subtitle"
      app:subtitleCentered="true"
      app:title="@string/idepref_jdk_manager_title"
      app:titleCentered="true" />
  </com.google.android.material.appbar.AppBarLayout>

  <androidx.core.widget.NestedScrollView
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <!-- 说明来源：JDK 不是 sdkmanager 的包，用户常误以为在同一处管理 -->
      <com.google.android.material.textview.MaterialTextView
        android:id="@+id/jdk_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/jdk_apt_hint"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?android:attr/textColorSecondary" />

      <!-- JDK 卡片由代码动态填充 -->
      <LinearLayout
        android:id="@+id/jdk_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <!-- 操作输出面板：结构与 SDK 管理器一致（可折叠，操作时展开、成功即收起） -->
  <com.google.android.material.card.MaterialCardView
    android:id="@+id/output_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:visibility="gone"
    app:cardCornerRadius="12dp"
    tools:visibility="visible">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="12dp">

      <LinearLayout
        android:id="@+id/output_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/output_toggle_icon"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_marginEnd="8dp"
          android:contentDescription="@string/sdk_output_toggle"
          android:src="@drawable/ic_chevron_down" />

        <com.google.android.material.textview.MaterialTextView
          android:id="@+id/output_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
          tools:text="正在安装 JDK 21…" />
      </LinearLayout>

      <ScrollView
        android:id="@+id/output_scroll"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp">

        <com.google.android.material.textview.MaterialTextView
          android:id="@+id/output_text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="monospace"
          android:textSize="11sp" />
      </ScrollView>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</LinearLayout>
