<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:paddingHorizontal="@dimen/acs_ui_page_padding"
  android:paddingTop="@dimen/acs_ui_space_xl"
  android:paddingBottom="88dp">

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:layout_constraintWidth_max="@dimen/acs_ui_content_max_width"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/acs_ui_home_eyebrow"
      android:textAppearance="@style/acs_ui_text_caption"
      android:textColor="?attr/colorPrimary"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/getStarted"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_sm"
      android:accessibilityHeading="true"
      android:fontFamily="sans-serif-medium"
      android:text="@string/acs_ui_home_title"
      android:textAppearance="@style/acs_ui_text_title"
      android:textSize="30sp" />

    <TextView
      android:id="@+id/greetingText"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_sm"
      android:text="@string/acs_ui_home_subtitle"
      android:textAppearance="@style/acs_ui_text_body"
      android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
      android:id="@+id/project_actions"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_xl"
      android:baselineAligned="false"
      android:orientation="horizontal">

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/home_create_project"
        style="@style/acs_ui_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:minHeight="148dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:strokeWidth="0dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="@dimen/acs_ui_space_lg">

          <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_add"
            app:tint="?attr/colorOnPrimaryContainer" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/acs_ui_space_xl"
            android:text="@string/create_project"
            android:textAppearance="@style/acs_ui_text_section"
            android:textColor="?attr/colorOnPrimaryContainer" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/acs_ui_space_xs"
            android:text="@string/acs_ui_home_create_hint"
            android:textAppearance="@style/acs_ui_text_caption"
            android:textColor="?attr/colorOnPrimaryContainer" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/home_open_project"
        style="@style/acs_ui_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:minHeight="148dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="@dimen/acs_ui_space_lg">

          <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_folder"
            app:tint="?attr/colorPrimary" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/acs_ui_space_xl"
            android:text="@string/acs_ui_home_open"
            android:textAppearance="@style/acs_ui_text_section" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/acs_ui_space_xs"
            android:text="@string/acs_ui_home_open_hint"
            android:textAppearance="@style/acs_ui_text_caption" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
      android:id="@+id/home_clone_project"
      style="@style/acs_ui_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_md"
      android:clickable="true"
      android:focusable="true"
      app:cardBackgroundColor="?attr/colorSurface"
      app:strokeWidth="0dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/acs_ui_space_lg"
        android:paddingVertical="@dimen/acs_ui_space_md">

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_git"
          app:tint="?attr/colorPrimary" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="@dimen/acs_ui_space_lg"
          android:orientation="vertical">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/acs_ui_home_clone"
            android:textAppearance="@style/acs_ui_text_body"
            android:textStyle="bold" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/acs_ui_space_xs"
            android:text="@string/acs_ui_home_clone_hint"
            android:textAppearance="@style/acs_ui_text_caption" />
        </LinearLayout>

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_marginStart="@dimen/acs_ui_space_sm"
          android:importantForAccessibility="no"
          android:rotation="180"
          android:src="@drawable/ic_arrow_back"
          app:tint="?attr/colorOnSurfaceVariant" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_xl"
      android:layout_marginBottom="@dimen/acs_ui_space_md"
      android:accessibilityHeading="true"
      android:text="@string/acs_ui_home_tools"
      android:textAppearance="@style/acs_ui_text_section" />

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/actions"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:nestedScrollingEnabled="false"
      android:overScrollMode="never"
      app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
      app:spanCount="2"
      tools:itemCount="4"
      tools:listitem="@layout/layout_main_action_item" />
  </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
