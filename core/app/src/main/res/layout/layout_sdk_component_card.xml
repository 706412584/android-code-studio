<?xml version="1.0" encoding="utf-8"?><!--
  ~  This file is part of AndroidIDE.
  ~
  ~  SDK 管理器里的一张组件卡片：标题 + 已安装版本 + 可安装版本（点选即装）。
  -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginHorizontal="@dimen/acs_ui_page_padding"
  android:layout_marginTop="@dimen/acs_ui_space_sm"
  style="@style/acs_ui_card">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/acs_ui_space_lg">

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/component_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAppearance="@style/acs_ui_text_section"
      tools:text="Build-tools" />

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/component_description"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_xs"
      android:textAppearance="@style/acs_ui_text_caption"
      android:textColor="?attr/colorOnSurfaceVariant"
      tools:text="打包工具（aapt2 / d8 / zipalign）；AGP 有最低版本要求" />

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/component_installed"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_md"
      android:textAppearance="@style/acs_ui_text_body"
      tools:text="已安装：35.0.1, 36.0.0" />

    <!-- 已安装版本：每个一个带删除图标的 chip，点图标即卸载（先二次确认）。
         单独成组而不是把按钮塞进上一行的文本里——版本多时文本行换行会导致按钮错位。 -->
    <com.google.android.material.chip.ChipGroup
      android:id="@+id/installed_chips"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_xs"
      app:chipSpacingHorizontal="@dimen/acs_ui_space_xs"
      app:chipSpacingVertical="@dimen/acs_ui_space_xs"
      tools:ignore="MissingConstraints" />

    <com.google.android.material.textview.MaterialTextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/acs_ui_sdk_installed_hint"
      android:textAppearance="@style/acs_ui_text_caption" />

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/available_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_md"
      android:text="@string/acs_ui_sdk_available"
      android:textAppearance="@style/acs_ui_text_body" />

    <!-- 可安装版本：横向 chip 流式排列，点一个即装 -->
    <com.google.android.material.chip.ChipGroup
      android:id="@+id/available_chips"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_md"
      app:chipSpacingHorizontal="@dimen/acs_ui_space_xs"
      app:chipSpacingVertical="@dimen/acs_ui_space_xs"
      tools:ignore="MissingConstraints" />

    <!-- 「新建项目时默认用哪个版本」——仅 build-tools 卡显示（它是设备级设置，
         两个组件共享同一套工具链，不该每个项目各选一次）。点击弹出选择。 -->
    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/default_version_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_md"
      android:background="?attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:minHeight="@dimen/acs_ui_touch_target"
      android:paddingHorizontal="@dimen/acs_ui_space_sm"
      android:paddingVertical="@dimen/acs_ui_space_sm"
      android:textAppearance="@style/acs_ui_text_body"
      android:textColor="?attr/colorPrimary"
      android:visibility="gone"
      tools:text="默认版本：36.0.0"
      tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/component_hint"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_sm"
      android:textAppearance="@style/acs_ui_text_caption"
      android:textColor="?attr/colorOnSurfaceVariant"
      android:visibility="gone"
      tools:text="正在获取可安装版本…"
      tools:visibility="visible" />
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
