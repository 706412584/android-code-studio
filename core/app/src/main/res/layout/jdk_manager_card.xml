<?xml version="1.0" encoding="utf-8"?><!--
  ~  This file is part of AndroidCodeStudio.
  ~
  ~  JDK 管理器里的一张卡：标题（JDK 版本）+ 状态 + 动作按钮（使用/安装/卸载）。
  ~  与 SDK 管理器的卡片不同：JDK 的候选是**固定几个版本**（apt 源里有的），
  ~  每个版本的状态只有「已装/未装」且最多一个「使用中」，所以不用 chip 列表。
  -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginHorizontal="@dimen/acs_ui_page_padding"
  android:layout_marginTop="@dimen/acs_ui_space_sm"
  style="@style/acs_ui_card">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/acs_ui_space_lg">

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/jdk_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAppearance="@style/acs_ui_text_section"
      tools:text="JDK 21" />

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/jdk_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_xs"
      android:textAppearance="@style/acs_ui_text_body"
      android:textColor="?attr/colorPrimary"
      tools:text="已安装 · 使用中" />

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/jdk_path"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_sm"
      android:fontFamily="monospace"
      android:textSize="@dimen/acs_ui_caption_size"
      android:textColor="?attr/colorOnSurfaceVariant"
      tools:text="$PREFIX/lib/jvm/java-21-openjdk" />

    <!-- 动作区：按状态显示「使用」/「安装」/「卸载」，由代码决定可见性 -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/acs_ui_space_md"
      android:gravity="end"
      android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/jdk_use_button"
        style="@style/acs_ui_button_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jdk_use_action"
        android:visibility="gone"
        tools:visibility="visible" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/jdk_install_button"
        style="@style/acs_ui_button_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jdk_install_action"
        android:visibility="gone"
        tools:visibility="visible" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/jdk_uninstall_button"
        style="@style/acs_ui_button_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/acs_ui_space_xs"
        android:text="@string/jdk_uninstall_action"
        android:visibility="gone"
        tools:visibility="visible" />
    </LinearLayout>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
