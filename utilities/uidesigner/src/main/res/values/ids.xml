<!--
  导航目的地 id。

  这些 id 原定义在 res/navigation/nav_viewinfo.xml 里，但该目录在 AGP 8.13 的
  library 资源打包阶段被忽略（见 ViewInfoSheet 的代码建图注释）。改为代码建图后，
  导航图不再来自 XML，而 ViewInfoSheet / ViewInfoFragment / AddAttrFragment 仍按
  R.id.<目的地> 引用它们，故在此显式声明。
-->
<resources>
  <item name="viewInfoFragment" type="id" />
  <item name="addAttrFragment" type="id" />
  <item name="attrValueEditorFragment" type="id" />
</resources>
