<?xml version="1.0" encoding="utf-8"?>
<!--
  通用助手 App（剥离验证模块）。

  只声明一个 Activity，不引任何 ACS 组件——这个模块的 manifest 里出现
  com.tom.rv2ide.* 就说明验证失败。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application
    android:label="Assistant (standalone probe)"
    android:theme="@android:style/Theme.DeviceDefault.Light">

    <activity
      android:name=".ProbeActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!--
      第 2 步验证：Compose 渲染层。
      与 ProbeActivity 并列而非替换——第 1 步（内核可独立消费）的结论仍需要可复现。
    -->
    <activity
      android:name=".ChatDemoActivity"
      android:exported="true"
      android:label="Assistant chat (render probe)"
      android:theme="@android:style/Theme.Material.Light.NoActionBar" />
  </application>

</manifest>
